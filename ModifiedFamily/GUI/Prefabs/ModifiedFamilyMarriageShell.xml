                                            </ListPanel>
                                          </Children>
                                        </Widget>

                                        <EncyclopediaDivider Id="MarriageHeroFamilyDivider" MarginTop="20" Parameter.Title="@FamilyText" Parameter.ItemList="..\MarriageHeroFamilyGrid" />
                                        <NavigatableGridWidget Id="MarriageHeroFamilyGrid" DataSource="{Family}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" SuggestedWidth="350" SuggestedHeight="350" DefaultCellWidth="100" DefaultCellHeight="110" HorizontalAlignment="Left" ColumnCount="7" MarginTop="30" MarginLeft="20" MarginBottom="20">
                                          <ItemTemplate>
                                            <EncyclopediaSubPageElement>
                                              <Children>
                                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" Text="@Role" PositionYOffset="-17" Brush="Encyclopedia.SubPage.Element.Name.Text" />
                                              </Children>
                                            </EncyclopediaSubPageElement>
                                          </ItemTemplate>
                                        </NavigatableGridWidget>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="12" MarginBottom="30" Brush="Encyclopedia.SubPage.Title.Text" Brush.TextHorizontalAlignment="Center" Brush.FontSize="23" Text="@PairingText" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </Widget>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                        <ScrollbarWidget Id="HeroDetailScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="18" HorizontalAlignment="Right" MarginBottom="255" AlignmentAxis="Vertical" Handle="HeroDetailScrollbarHandle" MinValue="0" MaxValue="100">
                          <Children>
                            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Bed" />
                            <BrushWidget Id="HeroDetailScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="50" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Handle" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </ScrollablePanel>
                  </Children>
                </ListPanel>

                <!-- The marriage agreement stays on the selected hero page, matching the mock-up's bottom arrangement panel. -->
                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="242" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginLeft="388" MarginRight="12" Brush="Encyclopedia.SoundBrush" Sprite="BlankWhiteSquare_9" Brush.Color="#120E0A88">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="4" HorizontalAlignment="Center" VerticalAlignment="Top" Sprite="Encyclopedia\list_filters_divider" />
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="28" MarginRight="28" MarginTop="7" MarginBottom="7" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="38" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Brush="Encyclopedia.SubPage.Title.Text" Brush.FontSize="25" Brush.TextHorizontalAlignment="Left" Text="@TermsTitle" />
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Center" MarginLeft="16" Sprite="Encyclopedia\list_filters_divider" />
                          </Children>
                        </ListPanel>

                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="112" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="20" MarginRight="30" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" Brush="Encyclopedia.SubPage.Title.Text" Brush.FontSize="21" Brush.TextHorizontalAlignment="Left" Text="@DirectionTitle" />
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64" MarginTop="8" VerticalAlignment="Center">
                                  <Children>
                                    <Standard.DropdownWithHorizontalControl Parameter.SelectorDataSource="{MarriageDirectionSelector}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Children>
                                </Widget>
                              </Children>
                            </ListPanel>

                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" Sprite="Encyclopedia\divider_vertical" />

                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="32">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" Brush="Encyclopedia.SubPage.Title.Text" Brush.FontSize="21" Brush.TextHorizontalAlignment="Left" Text="@GiftTitle" />
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="360" SuggestedHeight="58" MarginTop="30" HorizontalAlignment="Left">
                                  <Children>
                                    <Standard.DropdownWithHorizontalControl Parameter.SelectorDataSource="{MarriageGiftSelector}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Children>
                                </Widget>
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginBottom="3" StackLayout.LayoutMethod="HorizontalLeftToRight" IsVisible="@IsGiftAmountEnabled">
                                  <Children>
                                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="100" MarginRight="8" Brush="Encyclopedia.SubPage.Info.Text" Brush.FontSize="17" Brush.TextHorizontalAlignment="Right" Text="@GiftAmountText" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="36" VerticalAlignment="Center">
                                      <Children>
                                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Barter.AmountInput.Input" ClipContents="false" />
                                        <IntegerInputTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Barter.AmountInput.Text" IntText="@GiftAmount" MaxInt="100000000" MinInt="0" EnableClamp="true" ClipContents="false" UpdateChildrenStates="true" DoNotPassEventsToChildren="true" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ListPanel>

                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="25" Brush="Encyclopedia.SubPage.Info.Text" Brush.FontSize="16" Brush.TextHorizontalAlignment="Center" Text="@TermsValidationText" />
                        <ButtonWidget Command.Click="ExecuteSubmitTerms" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="330" SuggestedHeight="46" HorizontalAlignment="Center" Brush="Popup.Done.Button" IsEnabled="@CanSubmitTerms">
                          <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@SubmitTermsText" /></Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>
                  </Children>
                </BrushWidget>
              </Children>
            </Widget>
          </Children>
        </BrushWidget>

        <!-- Native encyclopedia close-button placement and visuals, bound to this screen's close command. -->
        <ButtonWidget Command.Click="ExecuteClose" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Popup.CloseButton.Width" SuggestedHeight="!Popup.CloseButton.Height" HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="-465" MarginLeft="1465" Brush="Popup.CloseButton" />
      </Children>
    </BrushWidget>
  </Window>
