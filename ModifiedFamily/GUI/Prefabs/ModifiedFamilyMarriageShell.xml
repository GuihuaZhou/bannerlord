                                <NavigatableGridWidget Id="MarriageHeroGrid" DataSource="{EligibleHeroes}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DefaultCellWidth="1000" DefaultCellHeight="142" ColumnCount="1">
                                  <ItemTemplate>
                                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="980" SuggestedHeight="126" MarginLeft="8" MarginRight="8" MarginTop="8" MarginBottom="8" Brush="Popup.SelectionElement.Tuple" Command.Click="ExecuteSelect" UpdateChildrenStates="true">
                                      <Children>
                                        <ImageIdentifierWidget DataSource="{Portrait}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="88" SuggestedHeight="88" MarginLeft="18" VerticalAlignment="Center" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" IsEnabled="false" />
                                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="310" SuggestedHeight="34" MarginLeft="126" MarginTop="14" Brush="Encyclopedia.SubPage.Title.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="24" Text="@Name" />
                                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="310" SuggestedHeight="26" MarginLeft="126" MarginTop="52" Brush="Encyclopedia.SubPage.Info.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="18" Text="@RoleText" />
                                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="310" SuggestedHeight="26" MarginLeft="126" MarginTop="84" Brush="Encyclopedia.SubPage.Info.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="18" Text="@AgeText" />
                                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="245" SuggestedHeight="26" MarginLeft="465" MarginTop="84" Brush="Encyclopedia.SubPage.Info.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="18" Text="@CultureText" />
                                        <ListPanel DataSource="{Traits}" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="72" HorizontalAlignment="Right" MarginRight="55" MarginTop="24">
                                          <ItemTemplate>
                                            <EncyclopediaHeroTraitVisualWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" MarginLeft="-5" MarginRight="-5" TraitId="@TraitId" TraitValue="@Value">
                                              <Children>
                                                <HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
                                              </Children>
                                            </EncyclopediaHeroTraitVisualWidget>
                                          </ItemTemplate>
                                        </ListPanel>
                                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="28" SuggestedHeight="50" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="14" Brush="Encyclopedia.SubPage.Title.Text" Brush.FontSize="30" Text="›" />
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </NavigatableGridWidget>
                              </Children>
                            </Widget>
                            <ScrollbarWidget Id="MarriageHeroScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="18" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="MarriageHeroScrollbarHandle" MinValue="0" MaxValue="100">
                              <Children>
                                <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Bed" />
                                <BrushWidget Id="MarriageHeroScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="50" HorizontalAlignment="Center" Brush="Encyclopedia.Scrollbar.Flat.Handle" />
                              </Children>
                            </ScrollbarWidget>
