                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Right" Sprite="Encyclopedia\divider_vertical" />
                      </Children>
                    </ListPanel>

                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48" MarginLeft="12" Brush="Encyclopedia.SubPage.Title.Text" Brush.TextHorizontalAlignment="Left" Brush.FontSize="28" Text="@CandidateTitleText" />
                        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="52" MarginRight="12" InnerPanel="MarriageHeroClip\MarriageHeroGrid" ClipRect="MarriageHeroClip" MouseScrollAxis="Vertical" VerticalScrollbar="..\MarriageHeroScrollbar" AutoHideScrollBars="true">
                          <Children>
                            <Widget Id="MarriageHeroClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
