    <string id="Fief_Intro_Line_Empire" text="这里是帝国的军区." />
    <string id="Fief_Intro_Line_Vlandia" text="这里是瓦兰迪亚的采邑." />
    <string id="Fief_Intro_Line_Aserai" text="这里是阿塞莱的伊克塔." />
    <string id="Fief_Intro_Line_Khuzait" text="这里是库塞特的兀鲁思." />
    <string id="Fief_Intro_Line_Sturgia" text="这里是斯特吉亚的王公领地." />
    <string id="Fief_Intro_Line_Battania" text="这里是巴丹尼亚的部族领地." />
