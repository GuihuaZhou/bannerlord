<?xml version="1.0" encoding="utf-8"?>
<AIRecruitmentTemplates>
  <!--
    AI party composition templates.

    min is a soft target used to prioritize missing troop groups.
    max is a hard recruitment limit. Values are percentages of the party's
    size limit, not fixed troop counts.

    culture must be a Bannerlord object reference such as Culture.aserai.
    partyType accepts mobileParty or garrison.
  -->

  <AIRecruitmentTemplate id="empire_mobile_party" culture="Culture.empire" partyType="mobileParty">
    <CombatRoles>
      <Infantry min="25" max="50"/>
      <Ranged min="15" max="35"/>
      <Cavalry min="20" max="40"/>
      <HorseArcher min="0" max="10"/>
    </CombatRoles>
    <Qualities>
      <LowTier min="15" max="50"/>
      <MiddleTier min="30" max="70"/>
      <TopTier min="5" max="30"/>
    </Qualities>
  </AIRecruitmentTemplate>
  <AIRecruitmentTemplate id="empire_garrison" culture="Culture.empire" partyType="garrison">
    <CombatRoles>
      <Infantry min="45" max="70"/>
      <Ranged min="25" max="50"/>
      <Cavalry min="5" max="15"/>
      <HorseArcher min="0" max="5"/>
    </CombatRoles>
    <Qualities>
      <LowTier min="40" max="50"/>
      <MiddleTier min="35" max="55"/>
      <TopTier min="10" max="25"/>
    </Qualities>
  </AIRecruitmentTemplate>

