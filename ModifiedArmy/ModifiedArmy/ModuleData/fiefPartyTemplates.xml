      <MilitiaTroops>
        <troop id="NPCCharacter.imperial_infantryman" weight="4"/>
        <troop id="NPCCharacter.imperial_archer" weight="1"/>
      </MilitiaTroops>
    </TroopComposition>
  </FiefPartyTemplate>

  <FiefPartyTemplate
      culture="Culture.empire" id="empire_castle"
