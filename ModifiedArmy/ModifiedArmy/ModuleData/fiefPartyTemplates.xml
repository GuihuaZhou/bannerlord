<FiefPartyTemplates>
  <!--
    封邑部队模板（Fief Party Templates）
    定义各文化在城镇（town）、港口城镇（town_port）、城堡（castle）中自动生成的部队构成与规模规则。

    每个 <FiefPartyTemplate> 对应一种定居点类型（如 empire_town），
    控制该定居点每周向"封邑兵力池"自动补充的士兵种类与数量上限。

    属性说明：
    - baseCapacity: 封建兵源池的固定容量，当前统一为 30
    - baseDailyProduction: 0级兵营的每日基础补充速度
    - dailyProductionStep: 兵营每提升一级增加的每日补充速度
    - 当前代码仍读取 baseLimit、villageBonus、minWeeklySupplement 和
      maxWeeklySupplement；迁移完成前暂时保留这些兼容属性。
    - maxServiceWeeks: 封邑兵最大服役周期（周），默认 5
    - returnCooldownWeeks: 归还后冷却周期（周），默认 3
    - prosperityCostPerTroop: 征召时每名士兵消耗的基础繁荣度，默认 4
    - hearthCostPerTroop: 征召时每名士兵消耗的户数，默认 1
  -->

  <!-- =============== Empire - 军区制，封邑弱，依赖雇佣兵/志愿兵 =============== -->
  <FiefPartyTemplate
      culture="Culture.empire" id="empire_town_port"
      baseCapacity="30"
      baseDailyProduction="0.71" dailyProductionStep="0.24"
      baseLimit="40" villageBonus="10"
      minWeeklySupplement="5" maxWeeklySupplement="10"
      maxServiceWeeks="5" returnCooldownWeeks="3"
      prosperityCostPerTroop="5" hearthCostPerTroop="1">
    <TroopComposition>
      <SergeantTroops>
        <troop id="NPCCharacter.imperial_equite" weight="2"/>
      </SergeantTroops>
      <MarineTroops>
        <troop id="NPCCharacter.empire_marine_t3" weight="1"/>
      </MarineTroops>
      <MilitiaTroops>
        <troop id="NPCCharacter.imperial_infantryman" weight="4"/>
        <troop id="NPCCharacter.imperial_archer" weight="1"/>
