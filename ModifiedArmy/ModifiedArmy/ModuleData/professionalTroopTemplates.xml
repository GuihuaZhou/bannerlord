<?xml version="1.0" encoding="utf-8"?>
<ProfessionalTroopTemplates>
  <!--
    职业兵源池模板。

    所有职业兵源池的容量固定为 30。兵营等级不扩大兵源池，
    只通过每日基础补充和每日补充步长提高补员速率。
    troop 的 barracksLevel 不在本文件重复定义，而是统一读取
    basic_troop_config.xml 中对应兵种的基础属性。

    外层 SoldierType 节点仅用于兼容现有分类与提高可读性。
    兵源池的最终目标构成直接由每个 troop 的 weight 决定。
  -->
  <!-- Empire -->
  <ProfessionalTroopTemplate culture="Culture.empire" id="empire_town_port" baseCapacity="30" baseDailyProduction="0.30" dailyProductionStep="0.25">
    <TroopComposition>
      <RetinueTroops>
        <troop id="NPCCharacter.imperial_cataphract" weight="1" />
      </RetinueTroops>
      <SergeantTroops>
        <troop id="NPCCharacter.imperial_veteran_infantryman" weight="3" />
        <troop id="NPCCharacter.imperial_menavliaton" weight="2" />
        <troop id="NPCCharacter.imperial_veteran_archer" weight="2" />
        <troop id="NPCCharacter.imperial_crossbowman" weight="2" />
      </SergeantTroops>
      <MarineTroops>
        <troop id="NPCCharacter.empire_marine_t3" weight="2" />
      </MarineTroops>
    </TroopComposition>
  </ProfessionalTroopTemplate>
