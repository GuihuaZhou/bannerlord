<?xml version="1.0" encoding="utf-8"?>
<MercenaryTemplates>
  <!--
    雇佣兵模板（Mercenary Templates）
    定义各文化酒馆的刷新概率，以及每个雇佣兵兵种的生成数量范围。

    属性说明：
    - culture: 文化 ID（如 Culture.vlandia）
    - spawnChance: 刷新概率（0-1），越高越容易刷新
    - MercenaryTroops/troop: 该定居点文化可以生成的雇佣兵
    - troop.id: 完整角色对象引用，例如 NPCCharacter.example_mercenary
    - troop.weight: 成功刷新后抽取该兵种的相对权重
    - troop.minCount: 该兵种每次生成的最少人数
    - troop.maxCount: 该兵种每次生成的最多人数

    兵种节点格式：
    <MercenaryTroops>
      <troop id="NPCCharacter.example_mercenary" weight="10" minCount="5" maxCount="10"/>
    </MercenaryTroops>

    Empire 可列出全部文化佣兵；其他输出文化通常只列本土佣兵。
    下方兵种池刻意留空，等待实际兵种 ID 确定后填写。
  -->

  <!-- 帝国：东罗马，最依赖雇佣兵 -->
  <MercenaryTemplate id="empire_mercenary" culture="Culture.empire" spawnChance="0.8">
    <MercenaryTroops>
      <!-- Vlandian mercenaries -->
      <troop id="NPCCharacter.western_crossbow_t4" weight="15" minCount="5" maxCount="10"/>
      <troop id="NPCCharacter.hire_knight" weight="8" minCount="3" maxCount="5"/>
      <!-- Rare direct T6 market offer. -->
      <troop id="NPCCharacter.hire_elite_knight" weight="1" minCount="1" maxCount="3"/>

      <!-- Sturgian mercenaries -->
      <troop id="NPCCharacter.hire_northern_axeman" weight="20" minCount="2" maxCount="10"/>
      <troop id="NPCCharacter.hire_northern_greatsman" weight="12" minCount="2" maxCount="10"/>

      <!-- Khuzait mercenaries -->
      <troop id="NPCCharacter.hire_steppe_lancer" weight="12" minCount="2" maxCount="5"/>
      <troop id="NPCCharacter.hire_steppe_horse_archer" weight="8" minCount="2" maxCount="5"/>

      <!-- Aserai mercenaries -->
      <troop id="NPCCharacter.desert_veteran_ranger" weight="10" minCount="2" maxCount="10"/>

      <troop id="NPCCharacter.eastern_mercenary" weight="10" minCount="2" maxCount="10"/>
    </MercenaryTroops>
  </MercenaryTemplate>

  <!-- 以下文化雇佣兵较少 -->
  <MercenaryTemplate id="aserai_mercenary" culture="Culture.aserai" spawnChance="0.05">
    <MercenaryTroops>
      <troop id="NPCCharacter.desert_veteran_ranger" weight="10" minCount="5" maxCount="10"/>
    </MercenaryTroops>
  </MercenaryTemplate>
  <MercenaryTemplate id="vlandia_mercenary" culture="Culture.vlandia" spawnChance="0.05">
    <MercenaryTroops>
      <troop id="NPCCharacter.western_crossbow_t4" weight="15" minCount="5" maxCount="10"/>
      <troop id="NPCCharacter.hire_knight" weight="8" minCount="3" maxCount="5"/>
      <troop id="NPCCharacter.hire_elite_knight" weight="1" minCount="2" maxCount="4"/>
    </MercenaryTroops>
  </MercenaryTemplate>
  <MercenaryTemplate id="sturgia_mercenary" culture="Culture.sturgia" spawnChance="0.05">
    <MercenaryTroops>
      <troop id="NPCCharacter.hire_northern_axeman" weight="20" minCount="5" maxCount="10"/>
      <troop id="NPCCharacter.hire_northern_greatsman" weight="12" minCount="5" maxCount="10"/>
    </MercenaryTroops>
  </MercenaryTemplate>
  <MercenaryTemplate id="battania_mercenary" culture="Culture.battania" spawnChance="0">
    <MercenaryTroops>
    </MercenaryTroops>
  </MercenaryTemplate>
  <MercenaryTemplate id="khuzait_mercenary" culture="Culture.khuzait" spawnChance="0.05">
    <MercenaryTroops>
      <troop id="NPCCharacter.hire_steppe_lancer" weight="12" minCount="5" maxCount="10"/>
      <troop id="NPCCharacter.hire_steppe_horse_archer" weight="8" minCount="5" maxCount="10"/>
    </MercenaryTroops>
  </MercenaryTemplate>
  <MercenaryTemplate id="nord_mercenary" culture="Culture.nord" spawnChance="0">
    <MercenaryTroops>
    </MercenaryTroops>
  </MercenaryTemplate>

</MercenaryTemplates>
