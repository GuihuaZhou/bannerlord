                        <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" ClipContents="false" GamepadNavigationIndex="0">
                          <Children>
                            <ListPanel Id="WarLogs" DataSource="{CurrentSelectedDiplomacyItem\WarLog}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <DiplomacyWarLogElement />
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
                <!-- Comparing Bars -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginRight="42" MarginBottom="110" IsHidden="@IsDisplayingWarLogs">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                      <Children>
                        <NavigationScopeTargeter ScopeID="KingdomDiplomacyStatBarsScope" ScopeParent="..\ClipRect" ScopeMovements="Horizontal" HasCircularMovement="false" ExtendDiscoveryAreaRight="-200" />
                        <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" ClipContents="false" ExtendCursorAreaLeft="-200" ExtendCursorAreaRight="-200" GamepadNavigationIndex="0">
                          <Children>
                            <ListPanel Id="StatBars" DataSource="{CurrentSelectedDiplomacyItem\Stats}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" SuggestedHeight="!Stat.Name.Height" Brush="Kingdom.Wars.Stat.Name.Text" Text="@Name" />
                                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="!Stat.Height" HorizontalAlignment="Center" MarginLeft="10" MarginRight="10">
                                      <Children>
                                        <!-- Faction 1 Bar -->
                                        <FillBarHorizontalWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="350" SuggestedHeight="35" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#00000040" FillWidget="Faction1ValueParent\FillWidget" InitialAmount="@Faction1Percentage" IsDirectionUpward="false" MaxAmount="100">
                                          <Children>
                                            <ListPanel Id="Faction1ValueParent" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalRightToLeft">
                                              <Children>
                                                <Widget Id="FillWidget" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" AlphaFactor="1" Color="@Faction1Color" />
                                                <TextWidget Id="Faction1ValueText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="5" MarginTop="5" Brush="Kingdom.Wars.Stat.Value.Text.Left" Brush.TextHorizontalAlignment="Right" ClipContents="false" IntText="@Faction1Value" />
                                              </Children>
                                            </ListPanel>
                                            <HintWidget DataSource="{Faction1Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
                                          </Children>
                                        </FillBarHorizontalWidget>
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="2" SuggestedHeight="35" Sprite="SPKingdom\Diplomacy\bar_seperator" />
                                        <!-- Faction 2 Bar -->
                                        <FillBarHorizontalWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="350" SuggestedHeight="35" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#00000040" FillWidget="Faction2ValueParent\FillWidget" InitialAmount="@Faction2Percentage" IsDirectionRightward="true" MaxAmount="100">
                                          <Children>
                                            <ListPanel Id="Faction2ValueParent" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="HorizontalLeftToRight">
                                              <Children>
                                                <Widget Id="FillWidget" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" AlphaFactor="1" Color="@Faction2Color" />
                                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="5" MarginTop="5" Brush="Kingdom.Wars.Stat.Value.Text.Right" ClipContents="false" IntText="@Faction2Value" />
                                              </Children>
                                            </ListPanel>
                                            <HintWidget DataSource="{Faction2Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
                                          </Children>
                                        </FillBarHorizontalWidget>
                                        <!-- Empty Vertical Space Widget -->
                                        <!-- <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="!Stat.Name.Height" /> -->
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ListPanel>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="20" MarginBottom="35" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1050" SuggestedHeight="2" HorizontalAlignment="Center" MarginBottom="15" Sprite="GradientDivider_9" AlphaFactor="0.4" />
                    <ListPanel DataSource="{SubjectActions}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center">
                      <ItemTemplate>
                        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="5" MarginRight="5" VerticalAlignment="Bottom">
                          <Children>
                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="260" HeightSizePolicy="CoverChildren" Brush="Kingdom.ParagraphSmall.Text" MarginBottom="10" Text="@Explanation" IsEnabled="@IsEnabled" DoNotAcceptEvents="true" />
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="227" SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="2">
                              <Children>
                                <HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="false" />
                                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="ButtonBrush2" UpdateChildrenStates="true" Command.Click="ExecuteAction" IsEnabled="@IsEnabled" GamepadNavigationIndex="0">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Kingdom.GeneralButtons.Text" Text="@Name" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </Widget>
                          </Children>
                        </ListPanel>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </ScrollablePanel>
    <ScrollbarWidget Id="ModifiedPoliticsDiplomacyDetailsScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="18" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="5" MarginTop="15" MarginBottom="15" AlignmentAxis="Vertical" Handle="ModifiedPoliticsDiplomacyDetailsScrollbarHandle" MinValue="0" MaxValue="100">
      <Children>
        <Widget Id="ModifiedPoliticsDiplomacyDetailsScrollbarBed" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.4" Color="#ECC79BFF" />
        <ImageWidget Id="ModifiedPoliticsDiplomacyDetailsScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" MinHeight="40" SuggestedWidth="8" SuggestedHeight="60" HorizontalAlignment="Center" Brush="Kingdom.Scrollbar.Handle" />
      </Children>
    </ScrollbarWidget>
  </Children>
</Widget>
